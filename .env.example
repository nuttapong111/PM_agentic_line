# ---- จำเป็น ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
PLANE_BASE_URL=https://plane.promes.co.th
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=promes
# สุ่มยาว ๆ ใช้ป้องกันหน้า Dashboard
DASHBOARD_TOKEN=

# PostgreSQL (บน Railway ใช้ ${{Postgres.DATABASE_URL}}) เว้นว่าง = เก็บเป็นไฟล์ใน DATA_DIR ไม่มีประวัติย้อนหลัง
DATABASE_URL=

# ---- ตั้งหลังทักบอทครั้งแรก (บอทจะตอบ user ID กลับมา) ----
OWNER_LINE_USER_ID=

# ---- ทางเลือก ----
PUBLIC_URL=http://localhost:3000
PORT=3000
TZ_NAME=Asia/Bangkok
DATA_DIR=./data
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low
# ติดตามเฉพาะบางโปรเจกต์ (identifier ใน Plane) เว้นว่าง = ทุกโปรเจกต์
PLANE_PROJECTS=["FDABIGDATA"]
# ชื่อเล่น -> อีเมลหรือชื่อใน Plane
NICKNAMES={"ต้น":"ton@promes.co.th"}
STALE_DAYS=5
BUG_LABEL=bug
DIGEST_CRON=30 8 * * 1-5
# Plane webhook (ถ้าใช้แจ้งเตือน Blocked ทันที)
PLANE_WEBHOOK_SECRET=
# false = ไม่ติดตั้ง rich menu อัตโนมัติตอนเริ่ม
RICHMENU_AUTO=true
